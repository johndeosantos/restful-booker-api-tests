    {
      "name": "UPDATE",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    const response = pm.response.json();\r\n\r\n    pm.test(\"First name is updated\", function () {\r\n        pm.expect(response.firstname).to.eql(\"John Updated\");\r\n    });\r\n\r\n    pm.test(\"Last name is correct\", function () {\r\n        pm.expect(response.lastname).to.eql(\"Santos\");\r\n    });\r\n\r\n    pm.test(\"Total price is updated\", function () {\r\n        pm.expect(response.totalprice).to.eql(2000);\r\n    });\r\n\r\n    pm.test(\"Additional needs are updated\", function () {\r\n        pm.expect(response.additionalneeds).to.eql(\"Breakfast and WiFi\");\r\n    });\r\n}"
            ]
          }
        }
      ],
