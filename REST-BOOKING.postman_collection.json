          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Booking ID exists\", function () {\r\n    pm.expect(response).to.have.property(\"bookingid\");\r\n    pm.expect(response.bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Booking details are returned\", function () {\r\n    pm.expect(response.booking).to.have.property(\"firstname\", \"John\");\r\n    pm.expect(response.booking).to.have.property(\"lastname\", \"Santos\");\r\n});\r\n\r\n// Save booking ID automatically\r\npm.collectionVariables.set(\"bookingId\", response.bookingid.toString());"
            ]
          }
        }
